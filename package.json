{
  "name": "n8n-nodes-hydradb",
  "version": "0.1.4",
  "description": "n8n community node for HydraDB: ingest knowledge and recall context.",
  "keywords": ["n8n-community-node-package", "hydradb", "memory", "retrieval"],
  "license": "MIT",
  "homepage": "https://hydradb.com",
  "author": {
    "name": "HydraDB",
    "email": "cloud@hydradb.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydra-db/hydradb-n8n-plugin.git"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && cp nodes/HydraDb/hydradb.svg dist/nodes/HydraDb/hydradb.svg && cp credentials/hydradb.svg dist/credentials/hydradb.svg",
    "lint": "tsc --noEmit"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/HydraDbApi.credentials.js"],
    "nodes": ["dist/nodes/HydraDb/HydraDb.node.js"]
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
